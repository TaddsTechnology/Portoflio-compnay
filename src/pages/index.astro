---
import CardSwap from '../components/CardSwap.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

// The only thing on this page is the stack. Heading is here for the document
// outline only; add visible copy later if the page needs it.
const title = 'Selected work';
const description = 'A selection of recent product design and front-end work.';
---

<Layout {title} {description}>
	<main class="page">
		<h1 class="sr-only">{title}</h1>
		<CardSwap projects={projects} />
	</main>

	<ProjectDialog projects={projects} />
</Layout>

<style>
	.page {
		display: grid;
		/* `safe` keeps the stack reachable on a viewport too short to centre in. */
		align-items: safe center;
		justify-items: stretch;
		min-height: 100dvh;
		padding: var(--s-4) var(--gutter);
	}
</style>
