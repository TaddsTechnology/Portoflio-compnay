---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
	eager?: boolean;
}

const { project, index, eager = false } = Astro.props;
const ordinal = String(index).padStart(2, '0');
---

<article class="card" data-card data-index={index - 1} data-title={project.title}>
	<div class="card__media">
		<img
			src={project.image}
			alt=""
			width="800"
			height="600"
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
			fetchpriority={eager ? 'high' : 'auto'}
		/>
		<span class="card__ordinal" aria-hidden="true">{ordinal}</span>
		<span class="card__arrow" aria-hidden="true">
			<svg viewBox="0 0 16 16">
				<path
					d="M3 8h9M8.5 3.5 13 8l-4.5 4.5"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</span>
	</div>

	<div class="card__body">
		<ul class="card__tags">
			{project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
			{project.tags.length > 3 ? <li>+{project.tags.length - 3}</li> : null}
		</ul>
		<h2 class="card__title">{project.title}</h2>
	</div>

	<button
		type="button"
		class="card__trigger"
		data-project-open={project.slug}
		aria-label={`View ${project.title} details`}
	></button>
</article>

<style>
	.card {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--card-w, 25rem);
		height: var(--card-h, 18.75rem);
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 0.875rem;
		background: var(--surface);
		box-shadow:
			0 1px 1px rgba(20, 21, 26, 0.03),
			0 18px 40px -24px rgba(20, 21, 26, 0.35);
		transform-style: preserve-3d;
		backface-visibility: hidden;
		/* No `will-change` here: with fifteen cards that is fifteen permanently
		   promoted layers. GSAP's force3D promotes them for the animation only. */

		/* Every size below is relative to the card, so a narrow card on a phone
		   keeps the same proportions instead of overflowing. */
		container-type: inline-size;

		/* A card is dragged, not clicked through, so the browser must not claim the
		   gesture for scrolling. */
		touch-action: none;
	}

	.card__media {
		position: relative;
		height: 72%;
		overflow: hidden;
		background: var(--paper);
		/* Animated so the photo can grow into the card when the text band goes. */
		transition: height 0.5s var(--ease-out);
	}

	.card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.01);
		transition: transform 0.9s var(--ease-out);
	}

	.card:hover .card__media img {
		transform: scale(1.06);
	}

	.card__ordinal,
	.card__arrow {
		position: absolute;
		top: clamp(0.75rem, 2.2cqw, 1.25rem);
		display: grid;
		place-items: center;
		height: clamp(1.5rem, 3.6cqw, 2.25rem);
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.88);
		color: var(--ink);
		backdrop-filter: blur(6px);
	}

	.card__ordinal {
		left: clamp(0.75rem, 2.2cqw, 1.25rem);
		padding-inline: clamp(0.5rem, 1.4cqw, 0.875rem);
		font-size: clamp(0.625rem, 1.5cqw, 0.8125rem);
		font-weight: 500;
		letter-spacing: 0.14em;
		font-variant-numeric: tabular-nums;
	}

	.card__arrow {
		right: clamp(0.75rem, 2.2cqw, 1.25rem);
		width: clamp(1.5rem, 3.6cqw, 2.25rem);
		color: var(--muted);
		transition:
			color 0.25s var(--ease-out),
			transform 0.35s var(--ease-out);
	}

	.card__arrow svg {
		width: 45%;
	}

	.card:hover .card__arrow {
		color: var(--accent);
		transform: translateX(2px);
	}

	.card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: clamp(0.375rem, 1.6cqw, 0.875rem);
		height: 28%;
		overflow: hidden;
		padding: clamp(1rem, 4cqw, 2.25rem) clamp(1rem, 4.6cqw, 2.5rem) clamp(1.125rem, 4.6cqw, 2.5rem);
	}

	.card__tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 clamp(0.375rem, 1.2cqw, 0.75rem);
		font-size: clamp(0.625rem, 1.5cqw, 0.8125rem);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.card__tags li + li::before {
		content: '·';
		margin-right: clamp(0.375rem, 1.2cqw, 0.75rem);
		color: var(--line-strong);
	}

	.card__title {
		display: -webkit-box;
		overflow: hidden;
		font-size: clamp(1rem, 6.4cqw, 2.75rem);
		color: var(--ink);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	/* Small cards: type clamps bottom out before the card does, so the text band
	   needs a bigger share of the height than it does on a large card. */
	@container (max-width: 24rem) {
		.card__media {
			height: 62%;
		}

		.card__body {
			height: 38%;
			padding: 0.75rem 0.875rem 0.875rem;
		}
	}

	/* Stretched hit area: the card content stays outside the button so the
	   heading and list keep their own semantics. */
	.card__trigger {
		position: absolute;
		inset: 0;
		z-index: 2;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.card__trigger:active {
		background: rgba(20, 21, 26, 0.04);
	}

	/* Scattered cards are scaled down far enough that the text band would render
	   under about 8px, so they show the photo alone — the details view carries
	   every word. */
	.card[data-compact='true'] .card__media {
		height: 100%;
	}

	.card[data-compact='true'] .card__body {
		display: none;
	}

	.card:hover,
	.card[data-dragging='true'] {
		box-shadow:
			0 2px 2px rgba(20, 21, 26, 0.04),
			0 26px 60px -26px rgba(20, 21, 26, 0.5);
	}
</style>
