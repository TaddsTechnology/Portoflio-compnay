---
import Card from './Card.astro';
import type { Project } from '../data/projects';

interface Props {
	projects: readonly Project[];
	label?: string;
	/** Base geometry: fixes the card's aspect ratio and caps how large it gets. */
	width?: number;
	height?: number;
	/** Seed for the scatter, so a reload reproduces the same arrangement. */
	seed?: number;
	/** Starting arrangement. The grid is the opening state. */
	mode?: 'scatter' | 'grid';
	/** `always` (default) animates regardless of the OS motion setting;
	    `system` honours `prefers-reduced-motion` and re-arranges instantly. */
	motion?: 'always' | 'system';
}

const {
	projects,
	label = 'Selected projects',
	width = 1100,
	height = 870,
	seed = 7,
	mode = 'grid',
	motion = 'always',
} = Astro.props;

const ratio = height / width;
---

<div
	class="swap"
	data-card-swap
	data-width={width}
	data-height={height}
	data-seed={seed}
	data-mode={mode}
	data-motion={motion}
	style={`--card-w-max:${width}px;--card-ratio:${ratio};`}
>
	<div class="swap__clip">
		<div class="swap__stage" role="group" aria-label={label}>
			{
				projects.map((project, i) => (
					<Card project={project} index={i + 1} eager={i < 2} />
				))
			}
		</div>
	</div>

	<div class="swap__dock">
		<button
			type="button"
			class="swap__mode"
			data-swap-mode
			aria-pressed="false"
			aria-label="Switch between the scattered deck and the grid"
		>
			<span class="swap__mode-label swap__mode-label--scatter">Arrange</span>
			<span class="swap__mode-label swap__mode-label--grid">Scatter</span>
		</button>

		<button type="button" class="swap__mode" data-swap-shuffle>Shuffle</button>
	</div>
</div>

<style>
	.swap {
		position: relative;
		--card-w: min(var(--card-w-max, 68.75rem), 100%);
		--card-h: calc(var(--card-w) * var(--card-ratio, 0.79));
		/* The field: cards use the whole page box, and the dock floats over it. */
		align-self: stretch;
	}

	.swap__clip {
		height: 100%;
		overflow: hidden;
	}

	.swap__stage {
		position: relative;
		width: 100%;
		height: 100%;
		perspective: 1200px;
		transform: translateZ(0);
	}

	.swap__dock {
		position: absolute;
		bottom: 0;
		left: 50%;
		display: flex;
		align-items: center;
		gap: var(--s-2) var(--s-4);
		transform: translateX(-50%);
	}

	.swap__mode {
		padding: 0.5rem 0.875rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--muted);
		font-size: var(--step--1);
		letter-spacing: 0.04em;
		transition:
			color 0.25s var(--ease-out),
			border-color 0.25s var(--ease-out);
	}

	.swap__mode:hover {
		border-color: var(--line-strong);
		color: var(--ink);
	}

	.swap__mode-label--grid {
		display: none;
	}

	.swap.is-grid .swap__mode-label--scatter {
		display: none;
	}

	.swap.is-grid .swap__mode-label--grid {
		display: inline-flex;
	}

	@media (pointer: coarse) {
		.swap__mode {
			padding: 0.625rem 1.125rem;
		}
	}
</style>

<script>
	import { initCardSwaps } from '../scripts/cardSwap';

	initCardSwaps();
</script>
